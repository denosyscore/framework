#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Runs one package's checks the way a user would install it: alone, with only
 * the dependencies it declares. Sibling DenoSys packages resolve from this
 * repository (path repositories), so a change is tested against the other
 * packages at the same commit instead of their last Packagist release.
 *
 *   bin/package-ci install <dir> [--lowest]   install a package (or any composer project) in place
 *   bin/package-ci check <package> [--skip-analyse]  composer test, analyse and analyse:types when defined
 *   bin/package-ci quickstart <package>       install into an empty project and run the README quick start
 *   bin/package-ci list                       print package names as a JSON array (for CI matrices)
 *   bin/package-ci layers                     check tiers, cycles and (with deptrac) undeclared package use
 *
 * Generated manifests are named composer.monorepo.json and are git-ignored.
 */

const MANIFEST = 'composer.monorepo.json';

$root = dirname(__DIR__);
$packages = $root . '/packages';

function fail(string $message): never
{
    fwrite(STDERR, $message . "\n");
    exit(1);
}

function run(string $command, string $cwd, array $env = []): void
{
    fwrite(STDERR, "\n> ({$cwd}) {$command}\n");
    $process = proc_open($command, [STDIN, STDOUT, STDERR], $pipes, $cwd, array_merge(getenv(), $env));
    if (!is_resource($process) || proc_close($process) !== 0) {
        fail("Command failed: {$command}");
    }
}

/** @return array<string, mixed> */
function readJson(string $file): array
{
    return json_decode((string) file_get_contents($file), true, flags: JSON_THROW_ON_ERROR);
}

function line(string $root): string
{
    $alias = readJson($root . '/composer.json')['extra']['branch-alias']['dev-main'] ?? null;
    if (!is_string($alias)) {
        fail('The root composer.json needs extra.branch-alias.dev-main.');
    }

    return $alias;
}

/** @return array<string, mixed> */
function siblingRepository(string $packages, string $line): array
{
    $versions = [];
    foreach (glob($packages . '/*/composer.json') ?: [] as $manifest) {
        $versions[readJson($manifest)['name']] = $line;
    }

    return ['type' => 'path', 'url' => $packages . '/*', 'options' => ['symlink' => true, 'versions' => $versions]];
}

/** Write composer.monorepo.json beside a manifest so siblings come from this checkout. */
function writeManifest(string $dir, string $packages, string $line): void
{
    $manifest = readJson($dir . '/composer.json');
    // Integration projects may declare their own path repositories to the old layout.
    $manifest['repositories'] = [siblingRepository($packages, $line)];
    $manifest['minimum-stability'] = 'dev';
    $manifest['prefer-stable'] = true;
    unset($manifest['config']['platform']);
    file_put_contents($dir . '/' . MANIFEST, json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");
}

function packageDir(string $packages, ?string $name): string
{
    if ($name === null || !is_file("{$packages}/{$name}/composer.json")) {
        fail("Unknown package [{$name}].");
    }

    return "{$packages}/{$name}";
}

$command = $argv[1] ?? '';
$line = line($root);

switch ($command) {
    case 'list':
        $names = array_map(static fn (string $path): string => basename(dirname($path)), glob($packages . '/*/composer.json') ?: []);
        echo json_encode(array_values($names)), "\n";
        break;

    case 'install':
        $dir = realpath($argv[2] ?? '') ?: fail('Usage: bin/package-ci install <dir> [--lowest]');
        writeManifest($dir, $packages, $line);
        $lowest = in_array('--lowest', $argv, true) ? ' --prefer-lowest' : '';
        run("composer update --no-interaction --no-progress --prefer-dist{$lowest}", $dir, ['COMPOSER' => MANIFEST]);
        break;

    case 'check':
        $dir = packageDir($packages, $argv[2] ?? null);
        $scripts = readJson($dir . '/composer.json')['scripts'] ?? [];
        $wanted = in_array('--skip-analyse', $argv, true) ? ['test'] : ['test', 'analyse', 'analyse:types'];
        foreach ($wanted as $script) {
            if (isset($scripts[$script])) {
                run("composer run-script --no-interaction {$script}", $dir, ['COMPOSER' => MANIFEST]);
            }
        }
        break;

    case 'quickstart':
        $dir = packageDir($packages, $argv[2] ?? null);
        $readme = (string) file_get_contents($dir . '/README.md');
        if (!preg_match('/<!-- quickstart(?: requires: ([^>]*?))? -->\s*```php\n(.*?)```/s', $readme, $match)) {
            fail("{$dir}/README.md has no quickstart block.");
        }
        $project = sys_get_temp_dir() . '/denosys-quickstart-' . basename($dir) . '-' . bin2hex(random_bytes(4));
        mkdir($project, 0700, true);
        file_put_contents($project . '/quickstart.php', $match[2]);
        file_put_contents($project . '/composer.json', json_encode([
            'repositories' => [siblingRepository($packages, $line)],
            'minimum-stability' => 'dev',
            'prefer-stable' => true,
        ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");
        $name = readJson($dir . '/composer.json')['name'];
        $extra = trim($match[1] ?? '');
        run('composer require --no-interaction --no-progress ' . escapeshellarg("{$name}:{$line}") . ($extra === '' ? '' : ' ' . $extra), $project);
        run('php quickstart.php', $project);
        break;

    case 'layers':
        // 1. Declarations follow the architecture: a package requires only packages
        //    in its own or a lower tier, and the requirement graph has no cycles.
        $tiers = readJson($root . '/composer.json')['extra']['denosys']['tiers'] ?? fail('extra.denosys.tiers is missing.');
        $tierOf = [];
        foreach (array_values($tiers) as $level => $members) {
            foreach ($members as $member) {
                $tierOf[$member] = $level;
            }
        }
        $requires = [];
        $problems = [];
        foreach (glob($packages . '/*/composer.json') ?: [] as $manifestPath) {
            $package = basename(dirname($manifestPath));
            if (!isset($tierOf[$package])) {
                $problems[] = "{$package} is not assigned to a tier in extra.denosys.tiers.";
                continue;
            }
            $requires[$package] = [];
            foreach (array_keys(readJson($manifestPath)['require'] ?? []) as $dependency) {
                if (str_starts_with($dependency, 'denosyscore/')) {
                    $requires[$package][] = substr($dependency, strlen('denosyscore/'));
                }
            }
        }
        $tierNames = array_keys($tiers);
        foreach ($requires as $package => $dependencies) {
            foreach ($dependencies as $dependency) {
                if (!isset($tierOf[$dependency])) {
                    $problems[] = "{$package} requires {$dependency}, which is not a monorepo package.";
                } elseif ($tierOf[$dependency] > $tierOf[$package]) {
                    $problems[] = "{$package} ({$tierNames[$tierOf[$package]]}) requires {$dependency} from the higher {$tierNames[$tierOf[$dependency]]} tier.";
                }
            }
        }
        $visit = static function (string $package, array $path) use (&$visit, $requires, &$problems): void {
            foreach ($requires[$package] ?? [] as $dependency) {
                if (in_array($dependency, $path, true)) {
                    $cycle = [...array_slice($path, (int) array_search($dependency, $path, true)), $dependency];
                    $problems[] = 'Requirement cycle: ' . implode(' -> ', $cycle) . '.';
                    continue;
                }
                $visit($dependency, [...$path, $dependency]);
            }
        };
        foreach (array_keys($requires) as $package) {
            $visit($package, [$package]);
        }

        // 2. Code follows the declarations: deptrac fails on a reference to a
        //    DenoSys package that the referring package does not require.
        $yaml = "# Generated by bin/package-ci layers from the package manifests. Do not edit.\n"
            . "deptrac:\n  paths:\n    - ./src\n    - ./support\n    - ./packages\n  exclude_files:\n"
            . "    - '#/(tests|vendor|integration|stubs)/#'\n  layers:\n"
            . "    - name: framework\n      collectors:\n        - { type: directory, value: '^(?!.*/packages/).*/(src|support)/.*' }\n";
        // deptrac misreads hyphenated layer names in rulesets, so layers use underscores.
        $layer = static fn (string $package): string => str_replace('-', '_', $package);
        foreach (array_keys($requires) as $package) {
            $yaml .= "    - name: {$layer($package)}\n      collectors:\n        - { type: directory, value: 'packages/{$package}/src/.*' }\n";
        }
        $yaml .= "  ruleset:\n    framework: [" . implode(', ', array_map($layer, array_keys($requires))) . "]\n";
        foreach ($requires as $package => $dependencies) {
            $declared = array_filter($dependencies, static fn (string $d): bool => isset($requires[$d]));
            $yaml .= "    {$layer($package)}: [" . implode(', ', array_map($layer, $declared)) . "]\n";
        }
        file_put_contents($root . '/deptrac.yaml', $yaml);

        $problems = array_values(array_unique($problems));
        foreach ($problems as $problem) {
            fwrite(STDERR, "✗ {$problem}\n");
        }
        $deptrac = proc_open('vendor/bin/deptrac analyse --config-file=deptrac.yaml --no-progress', [STDIN, STDOUT, STDERR], $pipes, $root);
        $deptracFailed = !is_resource($deptrac) || proc_close($deptrac) !== 0;
        if ($problems !== [] || $deptracFailed) {
            fail('Layer check failed.');
        }
        echo "Package declarations follow the tiers, and code uses only declared packages.\n";
        break;

    case 'versions':
        // Every package shares one version line. Requirements on siblings must
        // use that line (`^X.Y`), and every branch alias must point at it. With
        // --tag vX.Y.Z the tag must belong to the line too; the split workflow
        // runs this before tagging, so a release cannot ship requirements on
        // the previous line.
        $alias = $line;
        if (!preg_match('/^(\d+)\.(\d+)\.x-dev$/', $alias, $parts)) {
            fail("The root branch alias [{$alias}] must look like X.Y.x-dev.");
        }
        $expected = "^{$parts[1]}.{$parts[2]}";
        $problems = [];
        foreach (glob($packages . '/*/composer.json') ?: [] as $manifestPath) {
            $manifest = readJson($manifestPath);
            $package = basename(dirname($manifestPath));
            if (($manifest['extra']['branch-alias']['dev-main'] ?? null) !== $alias) {
                $problems[] = "{$package}: extra.branch-alias.dev-main must be {$alias}.";
            }
            foreach (['require', 'require-dev'] as $section) {
                foreach ($manifest[$section] ?? [] as $dependency => $constraint) {
                    if (str_starts_with($dependency, 'denosyscore/') && $constraint !== $expected) {
                        $problems[] = "{$package}: {$section} {$dependency} is {$constraint}, expected {$expected}.";
                    }
                }
            }
        }
        $tagIndex = array_search('--tag', $argv, true);
        if ($tagIndex !== false) {
            $tag = (string) ($argv[$tagIndex + 1] ?? '');
            if (!preg_match('/^v(\d+)\.(\d+)\.\d+(-[0-9A-Za-z.-]+)?$/', $tag, $tagParts)) {
                $problems[] = "Tag [{$tag}] is not a vX.Y.Z version.";
            } elseif ($tagParts[1] !== $parts[1] || $tagParts[2] !== $parts[2]) {
                $problems[] = "Tag {$tag} is outside the {$parts[1]}.{$parts[2]} line. Raise extra.branch-alias and the sibling requirements to the new line first.";
            }
        }
        foreach ($problems as $problem) {
            fwrite(STDERR, "✗ {$problem}\n");
        }
        if ($problems !== []) {
            fail('Version line check failed.');
        }
        echo "Every package is on the {$parts[1]}.{$parts[2]} line.\n";
        break;

    default:
        fail("Usage: bin/package-ci install|check|quickstart|list|layers|versions\n");
}
