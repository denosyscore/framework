{
  "name": "denosyscore/support",
  "description": "Reusable support types for DenoSysCore packages",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/collections": "^12.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Denosys\\Support\\": "src/Support/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Denosys\\Support\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G"
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.10.x-dev"
    }
  }
}
