{
  "name": "denosyscore/config",
  "description": "Configuration repository with correct dot paths, typed reads and typed sections, plus one environment reader",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "denosyscore/contracts": "^0.22",
    "vlucas/phpdotenv": "^5.5"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Denosys\\Config\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Denosys\\Config\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.22.x-dev"
    }
  },
  "config": {
    "sort-packages": true
  }
}
