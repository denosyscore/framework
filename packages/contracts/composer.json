{
  "name": "denosyscore/contracts",
  "description": "Core framework contracts and interfaces",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "psr/container": "^2.0",
    "psr/event-dispatcher": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Denosys\\Contracts\\": "src/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1"
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress --memory-limit=1G"
  }
}
