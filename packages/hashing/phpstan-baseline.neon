parameters:
	ignoreErrors:
		-
			message: '#^Property Denosys\\Hashing\\Argon2IdHasher\:\:\$memory \(int\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Hashing/Argon2IdHasher.php

		-
			message: '#^Property Denosys\\Hashing\\Argon2IdHasher\:\:\$threads \(int\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Hashing/Argon2IdHasher.php

		-
			message: '#^Property Denosys\\Hashing\\Argon2IdHasher\:\:\$time \(int\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Hashing/Argon2IdHasher.php

		-
			message: '#^Strict comparison using \=\=\= between non\-empty\-string and false will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: src/Hashing/Argon2IdHasher.php

		-
			message: '#^Property Denosys\\Hashing\\BcryptHasher\:\:\$rounds \(int\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Hashing/BcryptHasher.php

		-
			message: '#^Strict comparison using \=\=\= between non\-empty\-string and false will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: src/Hashing/BcryptHasher.php

		-
			message: '#^Method Denosys\\Hashing\\HashManager\:\:driver\(\) should return Denosys\\Hashing\\HasherInterface but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/Hashing/HashManager.php

		-
			message: '#^Method Denosys\\Hashing\\HashManager\:\:resolve\(\) should return Denosys\\Hashing\\HasherInterface but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/Hashing/HashManager.php

		-
			message: '#^Parameter \#1 \$options of class Denosys\\Hashing\\Argon2IdHasher constructor expects array\<string, mixed\>, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Hashing/HashManager.php

		-
			message: '#^Parameter \#1 \$options of class Denosys\\Hashing\\BcryptHasher constructor expects array\<string, mixed\>, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Hashing/HashManager.php

		-
			message: '#^Property Denosys\\Hashing\\HashManager\:\:\$defaultDriver \(string\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Hashing/HashManager.php

		-
			message: '#^Trying to invoke mixed but it''s not a callable\.$#'
			identifier: callable.nonCallable
			count: 1
			path: src/Hashing/HashManager.php
