parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#2 \$string of function explode expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/RateLimiter/Middleware/ThrottleRequestsMiddleware.php

		-
			message: '#^Cannot cast mixed to int\.$#'
			identifier: cast.int
			count: 3
			path: src/RateLimiter/RateLimiter.php
