{
  "name": "denosyscore/validation",
  "description": "Validation engine and rules",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "denosyscore/database": "^0.19",
    "nesbot/carbon": "^2.72 || ^3.0",
    "psr/http-message": "^2.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5"
  },
  "conflict": {
    "denosyscore/http": "<0.3.2"
  },
  "autoload": {
    "psr-4": {
      "Denosys\\Validation\\": "src/Validation/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "test": "phpunit",
    "analyse:types": "phpstan analyse --no-progress --configuration=phpstan-types.neon"
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.19.x-dev"
    }
  }
}
