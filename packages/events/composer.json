{
  "name": "denosyscore/events",
  "description": "Event dispatching and listener provider components",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "psr/container": "^2.0",
    "psr/event-dispatcher": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Denosys\\Events\\": "src/Events/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "test": "phpunit"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.15.x-dev"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Denosys\\Events\\Tests\\": "tests/"
    }
  }
}
