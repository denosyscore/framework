{
  "name": "denosyscore/events",
  "description": "Event dispatching and listener provider components",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "denosyscore/contracts": "^0.10",
    "psr/event-dispatcher": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Denosys\\Events\\": "src/Events/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1"
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress --memory-limit=1G"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.10.x-dev"
    }
  }
}
