			message: '#^Call to method get\(\) on an unknown class Denosys\\Container\\ContainerInterface\.$#'
			identifier: class.notFound
			count: 1
			path: src/Events/EventServiceProvider.php

		-
			message: '#^Call to method has\(\) on an unknown class Denosys\\Container\\ContainerInterface\.$#'
