{
  "name": "denosyscore/framework",
  "description": "DenoSys framework runtime core",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4.1",
    "ext-fileinfo": "*",
    "ext-pdo": "*",
    "doctrine/inflector": "^2.1",
    "filp/whoops": "^2.18",
    "graham-campbell/result-type": "^1.1",
    "illuminate/collections": "^12.0",
    "laminas/laminas-diactoros": "^3.6",
    "laminas/laminas-httphandlerrunner": "^2.12",
    "league/flysystem": "^3.35.3",
    "league/flysystem-local": "^3.30",
    "monolog/monolog": "^3.9",
    "nesbot/carbon": "^3.10",
    "nyholm/psr7": "^1.8",
    "psr/container": "^2.0",
    "psr/event-dispatcher": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0",
    "psr/simple-cache": "^3.0",
    "ramsey/uuid": "^4.7",
    "symfony/console": "^7.4",
    "symfony/filesystem": "^7.4.23",
    "symfony/mailer": "^8.0",
    "vlucas/phpdotenv": "^5.5"
  },
  "require-dev": {
    "deptrac/deptrac": "^4.7",
    "fakerphp/faker": "^1.24",
    "friendsofphp/php-cs-fixer": "^3.89",
    "mockery/mockery": "^1.6",
    "pestphp/pest": "^4.1",
    "pestphp/pest-plugin-stressless": "^4.0",
    "pestphp/pest-plugin-type-coverage": "^4.0",
    "phpmd/phpmd": "^2.15 || ^3.0",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^4.0",
    "symfony/var-dumper": "^8.0"
  },
  "replace": {
    "denosyscore/auth": "self.version",
    "denosyscore/cache": "self.version",
    "denosyscore/console": "self.version",
    "denosyscore/container": "self.version",
    "denosyscore/contracts": "self.version",
    "denosyscore/database": "self.version",
    "denosyscore/encryption": "self.version",
    "denosyscore/events": "self.version",
    "denosyscore/filesystem": "self.version",
    "denosyscore/hashing": "self.version",
    "denosyscore/http": "self.version",
    "denosyscore/queue": "self.version",
    "denosyscore/rate-limiter": "self.version",
    "denosyscore/routing": "self.version",
    "denosyscore/session": "self.version",
    "denosyscore/validation": "self.version",
    "denosyscore/view": "self.version"
  },
  "conflict": {
    "aws/aws-sdk-php": "<3.371.4",
    "guzzlehttp/guzzle": "<7.15.2 || >=8.0.0,<8.0.1",
    "guzzlehttp/psr7": "<2.12.3",
    "mtdowling/jmespath.php": "<2.9.1"
  },
  "autoload": {
    "psr-4": {
      "Denosys\\Bootstrap\\": "src/Bootstrap/",
      "Denosys\\Config\\": "src/Config/",
      "Denosys\\Environment\\": "src/Environment/",
      "Denosys\\Framework\\": "src/Framework/",
      "Denosys\\Mail\\": "src/Mail/",
      "Denosys\\Auth\\": "packages/auth/src/Auth/",
      "Denosys\\Cache\\": "packages/cache/src/Cache/",
      "Denosys\\Console\\": "packages/console/src/Console/",
      "Denosys\\Container\\": "packages/container/src/Container/",
      "Denosys\\Container\\Exceptions\\": "packages/container/src/Exceptions/",
      "Denosys\\Contracts\\": "packages/contracts/src/",
      "Denosys\\Database\\": "packages/database/src/Database/",
      "Denosys\\Encryption\\": "packages/encryption/src/Encryption/",
      "Denosys\\Events\\": "packages/events/src/Events/",
      "Denosys\\Filesystem\\": "packages/filesystem/src/Filesystem/",
      "Denosys\\Hashing\\": "packages/hashing/src/Hashing/",
      "Denosys\\Http\\": "packages/http/src/Http/",
      "Denosys\\Http\\Exceptions\\": "packages/http/src/Exceptions/",
      "Denosys\\Http\\Security\\": "packages/http/src/Security/",
      "Denosys\\Queue\\": "packages/queue/src/Queue/",
      "Denosys\\RateLimiter\\": "packages/rate-limiter/src/RateLimiter/",
      "Denosys\\Routing\\": "packages/routing/src/",
      "Denosys\\Session\\": "packages/session/src/Session/",
      "Denosys\\Validation\\": "packages/validation/src/Validation/",
      "Denosys\\View\\": "packages/view/src/View/",
      "Denosys\\View\\Form\\": "packages/view/src/Form/",
      "Denosys\\View\\ValueObjects\\": "packages/view/src/ValueObjects/"
    },
    "classmap": [
      "src/Application.php"
    ],
    "files": [
      "support/helpers.php",
      "packages/http/src/legacy-validation-handler.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.11.x-dev"
    },
    "denosys": {
      "tiers": {
        "foundation": [
          "contracts",
          "container",
          "events"
        ],
        "infrastructure": [
          "database",
          "cache",
          "encryption",
          "hashing",
          "filesystem"
        ],
        "http": [
          "http",
          "routing",
          "session",
          "validation",
          "rate-limiter"
        ],
        "features": [
          "auth",
          "queue",
          "view",
          "console"
        ]
      },
      "tier-notes": {
        "console": "Part VIII places console in foundation; it moves there once packages register their own commands."
      }
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "phpstan/extension-installer": true
    }
  }
}
