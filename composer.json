{
  "name": "denosyscore/framework",
  "description": "DenoSys framework runtime core",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-fileinfo": "*",
    "ext-pdo": "*",
    "denosyscore/contracts": "^0.2",
    "denosyscore/events": "^0.2",
    "denosyscore/container": "^0.2",
    "denosyscore/cache": "^0.2",
    "denosyscore/rate-limiter": "^0.2",
    "denosyscore/hashing": "^0.2",
    "denosyscore/encryption": "^0.2",
    "denosyscore/database": "^0.2",
    "denosyscore/validation": "^0.2",
    "denosyscore/filesystem": "^0.2",
    "denosyscore/queue": "^0.2",
    "denosyscore/view": "^0.2",
    "denosyscore/http": "^0.2",
    "denosyscore/session": "^0.2",
    "denosyscore/auth": "^0.2",
    "denosyscore/console": "^0.2",
    "denosyscore/routing": "0.6.0-alpha.1",
    "doctrine/inflector": "^2.1",
    "geoip2/geoip2": "^2.13",
    "graham-campbell/result-type": "^1.1",
    "html2text/html2text": "^4.3",
    "laminas/laminas-diactoros": "^3.6",
    "laminas/laminas-httphandlerrunner": "^2.12",
    "league/flysystem": "^3.30",
    "league/flysystem-aws-s3-v3": "^3.30",
    "mailgun/mailgun-php": "^4.3",
    "monolog/monolog": "^3.9",
    "nesbot/carbon": "^3.10",
    "nyholm/psr7": "^1.8",
    "psr/container": "^2.0",
    "psr/event-dispatcher": "^1.0",
    "psr/log": "^3.0",
    "psr/simple-cache": "^3.0",
    "symfony/console": "^7.4",
    "symfony/filesystem": "^7.3",
    "symfony/http-client": "^5.4 || ^8.0",
    "symfony/mailer": "^8.0",
    "vlucas/phpdotenv": "^5.5"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "filp/whoops": "^2.18",
    "friendsofphp/php-cs-fixer": "^3.89",
    "mockery/mockery": "^1.6",
    "pestphp/pest": "^4.1",
    "pestphp/pest-plugin-stressless": "^4.0",
    "pestphp/pest-plugin-type-coverage": "^4.0",
    "phpmd/phpmd": "^2.15",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^4.0",
    "symfony/var-dumper": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "Denosys\\": "src/"
    },
    "files": [
      "support/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "phpstan/extension-installer": true
    }
  }
}
