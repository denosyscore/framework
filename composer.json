{
  "name": "denosyscore/validation",
  "description": "Validation engine and rules",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "denosyscore/contracts": "^0.2",
    "denosyscore/database": "^0.2 || ^0.3 || ^0.4",
    "nesbot/carbon": "^2.72 || ^3.0",
    "psr/http-message": "^2.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Denosys\\Validation\\": "src/Validation/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
